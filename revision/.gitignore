# Individual-level and bulky intermediates are not tracked.

# Per-taxon x per-analysis long table (6.3 MB); regenerate with 02b_consensus_merge.py
results/da_grid_with_multiplicity.csv

# Permuted association matrices cached by netCompare for reuse by diffnet.
# ~195 MB each. Pure intermediate: regenerated by 03_genus_networks.R.
results/networks/*/assoPerm.bmat
results/networks/*/assoPerm.desc.txt

# Installed R packages
env/rlibs/

# SLURM logs
slurm/logs/

# Per-analysis DA long tables (180 files, regenerable by 02d + its SLURM wrapper).
# The merged/aggregate tables in results/tables/ ARE tracked.
results/da_extended/daext_long_*.csv
results/da/da_long_*.csv

# Watchdog bookkeeping
slurm/logs/monitor_state.tsv

# Auxiliary pip venvs (binary trees; pins live in *-requirements.txt)
env/xgb-venv/
env/legacy-venv/
env/classo-venv/
env/build_venvs.log

# 07a per-seed design draws: ~100 files, regenerated in seconds by 07a from
# base.csv + the seed list. base.csv and validation.txt ARE tracked.
results/nested_models/designs/seed_*.csv

# netprops RDS caches: rebuilt (seeded, identical) by 06b on demand
results/networks/*/netprops_*.rds

# Per-participant rows (KORA sample IDs). Never tracked: participant-level
# data must not reach any remote. Kept on disk, regenerated by 05b/05c/07a.
results/alpha/alpha_persample.csv
results/phylo/faithpd_persample_*.csv
results/nested_models/designs/base.csv

# 02f full-cohort DA inputs: per-participant rows, regenerated by 02f in ~1 min
results/full_cohort/inputs/
results/da_full/da_long_*.csv
results/da_extended_full/daext_long_*.csv

# 05d per-participant alpha (full cohort)
results/alpha/alpha_full_persample.csv

# Full-design networks (03 --design full): permutation caches (~195 MB each)
# and cached netAnalyze objects, which embed the per-participant count matrices.
results/networks_full/*/assoPerm.bmat
results/networks_full/*/assoPerm.desc.txt
results/networks_full/*/netprops_*.rds
